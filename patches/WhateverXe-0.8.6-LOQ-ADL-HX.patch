+void XE::adlsProgramCDClock(void *controller,void *access) {
+    auto s=callbackXE;
+    if(!s->adlsSetCDClock || !s->orgTGLRegisterRead)return;
+    const uint32_t ref=FunctionCast(wrapTGLRegisterRead,s->orgTGLRegisterRead)(access,0x51004)>>29;
+    // DSSM[31:29]: 0 = 24 MHz, 1 = 19.2 MHz, 2 = 38.4 MHz.
+    static const uint64_t pll[] {24000000ULL*54,19200000ULL*68,38400000ULL*34};
+    if(ref<3)reinterpret_cast<void (*)(void *,uint64_t)>(s->adlsSetCDClock)(controller,pll[ref]);
+}
+
+uint64_t XE::wrapADLSCDClockProbe(void *controller) {
+    auto s=callbackXE;
+    if(s->adlsDisplaySelected && s->adlsDisableCDClock && s->adlsSetCDClock && s->orgTGLRegisterRead) {
+        auto access=*reinterpret_cast<void **>(static_cast<uint8_t *>(controller)+0xC40);
+        if(access) {
+            const uint32_t decimal=FunctionCast(wrapTGLRegisterRead,s->orgTGLRegisterRead)(access,0x46000)&0x7FFU;
+            static const uint32_t known[] {0x264,0x26E,0x44E,0x458,0x50E,0x518};
+            bool supported=false;for(auto v:known)supported|=(decimal==v);
+            if(!supported) {
+                FunctionCast(wrapADLSCDClockProbe,s->adlsDisableCDClock)(controller);
+                adlsProgramCDClock(controller,access);
+            }
+        }
+    }
+    return FunctionCast(wrapADLSCDClockProbe,s->orgADLSCDClockProbe)(controller);
+}
+
+uint32_t XE::wrapADLSSetMode(void *controller,void *fb,void *path,const void *timing) {
+    auto s=callbackXE;
+    if(s->adlsDisplaySelected && s->adlsWiring.panel) {
+        auto access=*reinterpret_cast<void **>(static_cast<uint8_t *>(controller)+0xC40);
+        if(access && s->orgTGLRegisterRead && s->orgTGLRegisterWrite) {
+            const auto rd=[&](uint32_t reg){return FunctionCast(wrapTGLRegisterRead,s->orgTGLRegisterRead)(access,reg);};
+            const auto wr=[&](uint32_t reg,uint32_t val){FunctionCast(wrapTGLRegisterWrite,s->orgTGLRegisterWrite)(access,reg,val);};
+            const uint32_t pp=rd(0xC7200);
+            if(s->adlsPanelPowerFn && pp!=~0U && !(pp&0x80000000U)) {
+                // hwSetPanelPower(2) powers ON the panel; 0/1 powers it OFF.
+                reinterpret_cast<uint32_t (*)(void *,uint32_t)>(s->adlsPanelPowerFn)(controller,2);
+            }
+            const uint32_t cdpll=rd(0x46070);
+            if(cdpll!=~0U && !(cdpll&0x80000000U)) {
+                const uint32_t dc=rd(0x45504);
+                if(dc!=~0U && (dc&3U)) {
+                    wr(0x45504,dc&~3U);
+                    IODelay(100);
+                }
+                adlsProgramCDClock(controller,access);
+                static const uint32_t dbuf[] {0x45008,0x44FE8};
+                for(auto reg:dbuf) {
+                    const uint32_t val=rd(reg);
+                    if(val==~0U || (val&0x40000000U))continue;
+                    wr(reg,val|0x80000000U);
+                    for(unsigned t=0;t<100 && !(rd(reg)&0x40000000U);++t)IODelay(10);
+                }
+            }
+            const uint32_t aux=rd(0x45444);
+            if(aux!=~0U && !(aux&1U)) {
+                wr(0x45444,aux|2U);
+                for(unsigned t=0;t<100 && !(rd(0x45444)&1U);++t)IODelay(10);
+            }
+        }
+    }
+    return FunctionCast(wrapADLSSetMode,s->orgADLSSetMode)(controller,fb,path,timing);
+}
